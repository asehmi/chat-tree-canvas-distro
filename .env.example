# Copy this file to .env at the repo root and fill in the values you need.
# Both app_rx and app_st load this same root .env file.

CHAT_API_USER_ID=<your dev user id, e.g. your email>

# Auth0 (optional — omit entirely to run app_rx/app_st with a dev-fallback
# identity instead of a real login flow). See .streamlit/secrets.toml.example
# for the matching app_st-side Auth0 config.
# AUTH0_DOMAIN=<your-tenant>.auth0.com
# AUTH0_CLIENT_ID=...
# AUTH0_CLIENT_SECRET=...
# ADMIN_ID_TOKEN=...
REFLEX_FE_BASE_URL=http://localhost:3000

# true = rerunning a node cascades to all descendants (BFS); false = only
# leaf nodes can be rerun/duplicated. Read once at process startup.
CASCADING_RERUNS=true

# Chat backend selection: "reference" is the only built-in provider — the
# minimal protocol in docs/PROVIDERS.md, served by mock_provider.py or
# insecure_agent_provider.py, both on :9000 by default.
CHAT_API_PROVIDER=reference
CHAT_API_BASE_URL=http://localhost:9000

# insecure_agent_provider.py only — pick ONE provider and set its key.
# See the README's "Try a real agent" section before running it.
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...
# Optional per-provider model override, e.g. ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL=
# GEMINI_MODEL=
# OPENROUTER_MODEL=

# insecure_agent_provider.py's market tools — optional. Unset means
# scrape_market_data/search use yfinance/DuckDuckGo only (no key needed);
# set it to try Polygon.io first instead.
# POLYGON_API_KEY=
