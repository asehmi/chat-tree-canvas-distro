# Streamlit Auth0 configuration — https://docs.streamlit.io/develop/api-reference/user/st.login
#
# Copy this file to .streamlit/secrets.toml and fill in the values from your
# Auth0 tenant (the same tenant/application .env uses for app_rx works fine —
# AUTH0_DOMAIN / AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET).
#
# Auth0 Application setup required in the Auth0 console (Regular Web App):
#   - Allowed Callback URLs: http://localhost:8765/oauth2callback
#   - Allowed Logout URLs:   http://localhost:8765
#   - Token Endpoint Authentication Method: Post
#
# app_st does NOT need `expose_tokens` or an `audience` claim: Auth0 login
# here only establishes a stable identity (st.user.email), which is handed
# straight to chat_tree.api_client.mint_session(email) — the same simple
# session-minting flow app_rx uses. No token exchange against a
# backend-specific endpoint.
#
# If AUTH0_DOMAIN is unset in .env, app_st runs without Auth0 at all (dev
# fallback identity) — this file is only needed to test the Auth0 path.

[auth]
redirect_uri  = "http://localhost:8765/oauth2callback"
cookie_secret = "generate-a-random-secret-e.g.-python -c 'import secrets; print(secrets.token_hex(32))'"

[auth.auth0]
client_id           = "<AUTH0_CLIENT_ID from .env>"
client_secret       = "<AUTH0_CLIENT_SECRET from .env>"
server_metadata_url = "https://<AUTH0_DOMAIN>/.well-known/openid-configuration"
client_kwargs        = { scope = "openid profile email" }
