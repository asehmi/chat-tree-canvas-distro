{
  "name": "chat-tree-canvas-react",
  "version": "0.1.0",
  "description": "Branching chat-tree canvas React component: ReactFlow nodes with typed response block renderers (text/tool/script/metric/table/chart), light/dark theming, and a controlled-component API for any host that owns the tree state.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.jsx",
  "module": "src/index.jsx",
  "exports": {
    ".": "./src/index.jsx",
    "./renderers": "./src/renderers/index.jsx",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "theme.css",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "reactflow": "11.11.4",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "plotly.js-dist-min": "2.35.2",
    "mermaid": "10.9.4"
  }
}
